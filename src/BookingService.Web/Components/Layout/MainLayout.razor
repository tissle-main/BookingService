@inherits LayoutComponentBase

<div class="min-h-screen bg-slate-50 text-slate-900">
    <header class="border-b border-slate-200 bg-white">
        <nav class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
            <a href="/" class="text-lg font-bold tracking-tight text-indigo-600">BookingService</a>
            <AuthorizeView Context="authContext">
                <Authorized>
                    <div class="flex items-center gap-4 text-sm">
                        <span class="text-slate-600">@authContext.User.Identity?.Name</span>
                        <button type="button" @onclick="LogoutAsync"
                                class="rounded-lg border border-slate-300 px-3 py-2 font-semibold text-slate-700 transition hover:bg-slate-100">
                            Sign out
                        </button>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <div class="flex items-center gap-4 text-sm">
                        <a href="/Auth/Login" class="font-semibold text-slate-600 hover:text-indigo-600">Sign in</a>
                        <a href="/Auth/Register" class="rounded-lg bg-indigo-600 px-3 py-2 font-semibold text-white hover:bg-indigo-700">Create account</a>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </header>

    <main>
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [Inject] private IJSRuntime Js { get; set; } = default!;
    [Inject] private NavigationManager Navigation { get; set; } = default!;

    private async Task LogoutAsync()
    {
        await Js.InvokeAsync<bool>("bookingServiceAuth.logout");
        Navigation.NavigateTo("/Auth/Login", forceLoad: true);
    }
}