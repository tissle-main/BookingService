<CascadingAuthenticationState>
    <Router AppAssembly=@typeof(Program).Assembly NotFoundPage=@typeof(NotFoundPage)>
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout=@typeof(MainLayout)>
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
    </Router>
</CascadingAuthenticationState>
