@using ErrorOr
@using Mediator
@using System.Security.Claims
@using BookingService.Web.Features.Rooms.Dtos
@using BookingService.Web.Features.Bookings.Dtos
@using BookingService.Web.Features.Auth.Dtos.Users
@using BookingService.Web.Features.Auth.Handlers.GetUsers
@using BookingService.Web.Features.Rooms.Handlers.GetRooms
@using BookingService.Web.Features.Bookings.Handlers.GetBookings

@page "/MyBookings"
@attribute [Authorize]
@inject IMediator Mediator
@inject HubConnection HubClient
@implements IAsyncDisposable

<PageTitle>My Bookings</PageTitle>

<section class="mx-auto max-w-7xl px-6 py-10">
    <div class="mb-8">
        <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">My Bookings</h1>
        <p class="mt-2 text-slate-600">Review the rooms you have booked and your upcoming schedule.</p>
    </div>

    @if (errors.Count > 0)
    {
        <div role="alert" class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
            @foreach (string error in errors)
            {
                <p>@error</p>
            }
        </div>
    }
    else if (isLoading)
    {
        <p class="text-sm text-slate-500">Loading your bookings...</p>
    }
    else if (bookings.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-300 bg-white px-6 py-12 text-center">
            <p class="font-semibold text-slate-900">No bookings yet</p>
            <p class="mt-2 text-sm text-slate-500">Your bookings will appear here once you reserve a room.</p>
        </div>
    }
    else
    {
        <div class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200">
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
                                <button type="button" @onclick='() => SetSort("Room")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Room <span aria-hidden="true">@GetSortIndicator("Room")</span>
                                </button>
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
                                <button type="button" @onclick='() => SetSort("When")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    When <span aria-hidden="true">@GetSortIndicator("When")</span>
                                </button>
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
                                <button type="button" @onclick='() => SetSort("Duration")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Duration <span aria-hidden="true">@GetSortIndicator("Duration")</span>
                                </button>
                            </th>
                            <th scope="col" class="px-6 py-3 text-left text-xs font-semibold tracking-wide text-slate-500 uppercase">
                                <button type="button" @onclick='() => SetSort("User")' class="inline-flex items-center gap-1 hover:text-indigo-600">
                                    Booked by <span aria-hidden="true">@GetSortIndicator("User")</span>
                                </button>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (BookingDto booking in SortedBookings)
                        {
                            <tr>
                                <td class="px-6 py-4 text-sm font-semibold whitespace-nowrap text-slate-900">@GetRoomName(booking.RoomId)</td>
                                <td class="px-6 py-4 text-sm whitespace-nowrap text-slate-600">@booking.BookingStart.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</td>
                                <td class="px-6 py-4 text-sm whitespace-nowrap text-slate-600">@booking.BookingDuration.TotalMinutes minutes</td>
                                <td class="px-6 py-4 text-sm whitespace-nowrap text-slate-600">@GetUserEmail(booking.UserId)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</section>

@code
{
    [CascadingParameter] private Task<AuthenticationState> AuthenticationStateTask { get; set; } = default!;

    private readonly List<string> errors = [];
    private List<BookingDto> bookings = [];
    private Dictionary<Guid, RoomDto> rooms = [];
    private Dictionary<Guid, UserDto> users = [];
    private List<IDisposable> SignalRSubscriptions = [];
    private string sortColumn = "When";
    private bool sortDescending;
    private bool isLoading = true;

    private IEnumerable<BookingDto> SortedBookings
    {
        get
        {
            switch(sortColumn)
            {
                case "Room":
                {
                    if(sortDescending)
                    {
                        return bookings.OrderByDescending(b => GetRoomName(b.RoomId)).ThenBy(b => b.BookingStart);
                    }
                    else
                    {
                        return bookings.OrderBy(b => GetRoomName(b.RoomId)).ThenBy(b => b.BookingStart);
                    }
                }
                case "Duration":
                {
                    if(sortDescending)
                    {
                        return bookings.OrderByDescending(booking => booking.BookingDuration).ThenBy(b => b.BookingStart);                        
                    }
                    else
                    {
                        return bookings.OrderBy(booking => booking.BookingDuration).ThenBy(b => b.BookingStart);
                    }                    
                }
                case "User":
                {
                    if(sortDescending)
                    {
                        return bookings.OrderByDescending(booking => GetUserEmail(booking.UserId)).ThenBy(b => b.BookingStart);
                    }
                    else
                    {
                        return bookings.OrderBy(booking => GetUserEmail(booking.UserId)).ThenBy(b => b.BookingStart);
                    }
                }
                default:
                {
                    if(sortDescending)
                    {
                        return bookings.OrderByDescending(booking => booking.BookingStart);
                    }
                    else
                    {
                        return bookings.OrderBy(booking => booking.BookingStart);
                    }
                }
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
        SignalRSubscriptions.Add(
            HubClient.On<Guid>(
                nameof(ISignalRClient.BookingsUpdated),
                async roomId => await base.InvokeAsync(
                    async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    }
                )
            )
        );
        SignalRSubscriptions.Add(
            HubClient.On(
                nameof(ISignalRClient.RoomsUpdated),
                async () => await base.InvokeAsync(
                    async () =>
                    {
                        await LoadDataAsync();
                        StateHasChanged();
                    }
                )
            )
        );
        if(HubClient.State is HubConnectionState.Disconnected)
        {
            await HubClient.StartAsync();
        }
    }
    private async ValueTask LoadDataAsync()
    {
        try
        {
            AuthenticationState authenticationState = await AuthenticationStateTask;
            string? userIdValue = authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);
            if (!Guid.TryParse(userIdValue, out Guid currentUserId))
            {
                errors.Add("The current user could not be identified.");
                return;
            }

            ErrorOr<IEnumerable<BookingDto>> bookingsResult = await Mediator.Send(new GetBookingsQuery([]));
            if (bookingsResult.IsError)
            {
                errors.AddRange(bookingsResult.Errors.Select(error => error.Description));
                return;
            }

            bookings = bookingsResult.Value.Where(booking => booking.UserId == currentUserId).ToList();
            if (bookings.Count == 0)
            {
                return;
            }

            Guid[] roomIds = bookings.Select(booking => booking.RoomId).Distinct().ToArray();
            ErrorOr<IEnumerable<RoomDto>> roomsResult = await Mediator.Send(new GetRoomsQuery(roomIds));
            if (roomsResult.IsError)
            {
                errors.AddRange(roomsResult.Errors.Select(error => error.Description));
                return;
            }

            rooms = roomsResult.Value.ToDictionary(room => room.Id);
            Guid[] userIds = bookings.Select(booking => booking.UserId).Distinct().ToArray();
            ErrorOr<IEnumerable<UserDto>> usersResult = await Mediator.Send(new GetUsersQuery(userIds));
            if (usersResult.IsError)
            {
                errors.AddRange(usersResult.Errors.Select(error => error.Description));
                return;
            }

            users = usersResult.Value.ToDictionary(user => user.Id);
        }
        catch (Exception)
        {
            errors.Add("Your bookings could not be loaded. Please try again.");
        }
        finally
        {
            isLoading = false;
        }
    }
    public async ValueTask DisposeAsync()
    {
        await HubClient.StopAsync();
        foreach(IDisposable subscription in SignalRSubscriptions)
        {
            subscription.Dispose();
        }
        SignalRSubscriptions.Clear();
    }
    private string GetRoomName(Guid roomId)
    {
        return rooms.TryGetValue(roomId, out RoomDto? room) ? room.Name : "Unknown room";
    }
    private string GetUserEmail(Guid userId)
    {
        return users.TryGetValue(userId, out UserDto? user) ? user.Email : "Unknown user";
    }
    private void SetSort(string column)
    {
        if (sortColumn == column)
        {
            sortDescending = !sortDescending;
            return;
        }

        sortColumn = column;
        sortDescending = false;
    }
    private string GetSortIndicator(string column)
    {
        return sortColumn == column ? (sortDescending ? "↓" : "↑") : string.Empty;
    }
}