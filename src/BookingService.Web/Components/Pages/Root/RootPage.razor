@page "/"
@attribute [Authorize]

@using BookingService.Web.Features.Auth

<PageTitle>Home</PageTitle>

<section class="mx-auto max-w-7xl px-6 py-12">
    <div class="bg-gradient-to-br overflow-hidden rounded-3xl from-indigo-600 via-indigo-600 to-violet-700 px-8 py-12 text-white shadow-xl sm:px-12">
        <AuthorizeView Context="authContext">
            <h1 class="mt-4 text-4xl font-bold tracking-tight sm:text-5xl">
                Welcome back, @authContext.User.Identity?.Name!
            </h1>
            <p class="mt-5 max-w-2xl text-lg leading-8 text-indigo-100">
                Manage your room reservations, check schedules, and find the right space for your next meeting.
            </p>
        </AuthorizeView>
    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-2">
        <AuthorizeView Roles="@AuthRoles.User">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm font-semibold tracking-wide text-indigo-600 uppercase">Your workspace</p>
                <h2 class="mt-2 text-2xl font-bold text-slate-900">Ready to book a room?</h2>
                <p class="mt-3 text-slate-600">Choose a room, review its schedule, and reserve an available time.</p>
                <a href="/BookRoom" class="mt-6 inline-flex rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white transition hover:bg-indigo-700">
                    Book a room
                </a>
            </div>
        </AuthorizeView>

        <AuthorizeView Roles="@AuthRoles.Admin">
            <div class="rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
                <p class="text-sm font-semibold tracking-wide text-violet-600 uppercase">Administration</p>
                <h2 class="mt-2 text-2xl font-bold text-slate-900">Keep bookings organized</h2>
                <p class="mt-3 text-slate-600">Manage rooms and review reservations across the entire service.</p>
                <div class="mt-6 flex flex-wrap gap-3">
                    <a href="/Rooms" class="inline-flex rounded-lg bg-indigo-600 px-4 py-2.5 font-semibold text-white transition hover:bg-indigo-700">Manage rooms</a>
                    <a href="/AllBookings" class="inline-flex rounded-lg border border-slate-300 px-4 py-2.5 font-semibold text-slate-700 transition hover:bg-slate-100">View all bookings</a>
                </div>
            </div>
        </AuthorizeView>
    </div>
</section>
